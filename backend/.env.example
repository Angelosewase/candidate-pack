# Copy to `.env` for local development (outside Docker) and adjust as needed.
# Docker Compose sets these via `environment:` instead, so no file is needed there.
# Variable names are case-insensitive (pydantic-settings).

# development | production (production refuses to boot with the dev JWT_SECRET)
ENVIRONMENT=development

# SQLAlchemy URL. Compose uses desk:deskpassword@db:5432/desk internally and
# maps it to localhost:5433 on the host; use the host port here.
DATABASE_URL=postgresql+psycopg://desk:deskpassword@localhost:5433/desk

# REQUIRED in production. Use a long random string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=dev-only-secret-change-me

# Access-token lifetime in minutes (default: 8h)
JWT_TTL_MINUTES=480

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max accepted CSV upload size in bytes (default: 50MB)
MAX_IMPORT_BYTES=52428800
